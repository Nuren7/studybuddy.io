# Copy to llmops/.env or use the repo root .env (rag_trace_demo.py loads both).
# Paste your real LangSmith API key on the LANGCHAIN_API_KEY line.

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__your_langsmith_api_key_here
LANGCHAIN_PROJECT=StudyBuddy-RAG-Monitoring
